{
  "name": "@warlord/engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Warlord Draft battle engine: draft, deploy, resolve. Pure and deterministic; no Node imports in dist/.",
  "scripts": {
    "build:data": "node scripts/build_data.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "battle": "tsx src/cli/battle.ts",
    "batch": "tsx src/cli/batch.ts",
    "build": "tsc -p tsconfig.build.json",
    "smoke": "node scripts/smoke_client.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data/*": "./data/*"
  },
  "files": [
    "dist",
    "data"
  ]
}
